#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "myAGV"
    doc = """Generated from Composed Stage of root layer /tmp/tmptp55se1a/myAGV.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_myagv_jnd_r5h2/usdex_myagv/myAGV.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_myagv_jnd_r5h2/temp_myagv/myagv.usd


Generated from Composed Stage of root layer <repo>/robots/myagv/usd/myagv.usd/myagv/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "myAGV"
{
    over "Geometry"
    {
        over "base_footprint" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysicsMassAPI"]
        )
        {
            bool newton:selfCollisionEnabled = 0
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.000648, 0.000648, 0.000648)
            float physics:mass = 1.8
            quatf physics:principalAxes = (1, 0, 0, 0)

            over "base_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (0, 0, 0)
                float3 physics:diagonalInertia = (0.000648, 0.000648, 0.000648)
                float physics:mass = 1.8
                quatf physics:principalAxes = (1, 0, 0, 0)
            }
        }
    }

    over "Physics"
    {
        def PhysicsFixedJoint "base_joint"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </myAGV/Geometry/base_footprint>
            custom rel physics:body1
            prepend rel physics:body1 = </myAGV/Geometry/base_footprint/base_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

