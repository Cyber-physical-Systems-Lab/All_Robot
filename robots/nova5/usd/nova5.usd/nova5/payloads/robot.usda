#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "nova5_robot"
    doc = """Generated from Composed Stage of root layer /tmp/tmp_yaifpvl/nova5_robot.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_nova5_w927vzra/usdex_nova5/nova5_robot.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_nova5_w927vzra/temp_nova5/nova5.usd


Generated from Composed Stage of root layer <repo>/robots/nova5/usd/nova5.usd/nova5/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "nova5_robot" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "Link1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "Link2" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "Link3" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "Link4" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "Link5" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "Link6" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "tool_link" (
                                        prepend apiSchemas = ["IsaacSiteAPI"]
                                    )
                                    {
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "joint1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint3" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint4" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint5" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint6" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

