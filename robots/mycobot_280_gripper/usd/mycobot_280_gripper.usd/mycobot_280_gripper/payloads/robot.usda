#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "firefighter"
    doc = """Generated from Composed Stage of root layer /tmp/tmpbty3xrmb/firefighter.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_mycobot_280_gripper_vmxw42x_/usdex_mycobot_280_gripper/firefighter.usdc


