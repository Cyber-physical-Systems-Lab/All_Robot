                                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                                )
                                                {
                                                }
                                            }

                                            over "gripper_right2" (
                                                prepend apiSchemas = ["IsaacLinkAPI"]
                                            )
                                            {
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "gripper_controller" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper_base_to_gripper_left2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper_base_to_gripper_right3" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
