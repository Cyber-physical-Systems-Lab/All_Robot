#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "nova5_robot"
    doc = """Generated from Composed Stage of root layer /tmp/tmpxwlk8hw6/nova5_robot.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_nova5_2f85_m50ld1ku/usdex_nova5_2f85/nova5_robot.usdc


