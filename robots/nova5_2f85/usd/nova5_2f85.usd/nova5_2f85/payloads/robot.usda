            over "base_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "Link1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "Link2" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "Link3" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
