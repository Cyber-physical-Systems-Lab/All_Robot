<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cps_robot_description</name>
  <version>1.0.0</version>
  <description>
    Digital-twin models (meshes, URDF, USD, MJCF) of the robots in the
    Cyber-physical Systems Lab, Uppsala University: Unitree Go2, myAGV,
    myCobot 280, Dobot Nova 5, Robotiq 2F-85 and lab composites.
  </description>
  <maintainer email="xuezhi.niu@it.uu.se">Xuezhi Niu</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/Cyber-physical-Systems-Lab/All_Robot</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- Gazebo Fortress (only needed for gazebo.launch.py) -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
